# Server Configuration - Production
PORT=3001
NODE_ENV=production
API_VERSION=v1

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/idea2prompt
MONGODB_MAX_POOL_SIZE=20
MONGODB_CONNECT_TIMEOUT=10000
MONGODB_SOCKET_TIMEOUT=60000

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_key_here_production
JWT_EXPIRES_IN=1h
JWT_ALGORITHM=HS256
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT=5000
REDIS_KEEP_ALIVE=60000

# CORS Configuration - Production
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-Id
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Rate Limiting - Production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# Log Configuration - Production
LOG_LEVEL=info
LOG_MAX_SIZE=50m
LOG_MAX_FILES=30
LOG_FORMAT=json

# AI Model API Keys
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
KLING_API_KEY=your_kling_api_key_here
GLM4V_API_KEY=your_glm4v_api_key_here
RUNWAY_API_KEY=your_runway_api_key_here
REPLICATE_API_KEY=your_replicate_api_key_here
MODEL_SCOPE_API_KEY=your_model_scope_api_key_here
SOCIAL_BLADE_API_KEY=your_social_blade_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_MODELS_TOKEN=your_github_models_token_here
STEP_AI_API_KEY=your_step_ai_api_key_here
BIG_MODEL_API_KEY=your_big_model_api_key_here
LTX_API_KEY=your_ltx_api_key_here
LONGCAT_API_KEY=your_longcat_api_key_here
WAN27_VIDEO_API_KEY=your_wan27_video_api_key_here
WAN27_I2V_API_KEY=your_wan27_i2v_api_key_here
JIMENG_API_KEY=your_jimeng_api_key_here

# AnimateDiff Configuration
ANIMATEDIFF_SERVICE_TYPE=replicate

# File Storage Configuration - Production
FILE_STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
LOCAL_MAX_FILE_SIZE=52428800

# Notification Configuration - Production
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@yourdomain.com
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@yourdomain.com
SMTP_SECURE=true
SMTP_REJECT_UNAUTHORIZED=true
ENABLE_NOTIFICATIONS=true

# Server Timeout Configuration
SERVER_TIMEOUT=30000
SERVER_KEEP_ALIVE_TIMEOUT=60000

# Exit on missing configuration
EXIT_ON_MISSING_CONFIG=true